@model Student
@{ ViewData["Title"] = "Delete student"; }
<div class="row"><div class="col-lg-7"><h1 class="h2 mb-4">Delete student</h1><div class="card border-danger shadow-sm"><div class="card-body p-4"><p class="lead">Are you sure you want to delete <strong>@Model.FullName</strong>?</p><p class="text-muted">This action cannot be undone.</p><dl class="row"><dt class="col-sm-5">Enrollment number</dt><dd class="col-sm-7">@Model.EnrollmentNumber</dd><dt class="col-sm-5">Course</dt><dd class="col-sm-7">@Model.Course</dd></dl><form asp-action="Delete" method="post"><input asp-for="Id" type="hidden" /><button class="btn btn-danger">Delete student</button> <a asp-action="Index" class="btn btn-link">Cancel</a></form></div></div></div></div>
